#!/usr/bin/env bash
# ═══ بوابةُ الدفع — لا تصل إلى GitHub دفعةٌ لم تمرَّ بما تمرُّ به السحابة ═══
# ثماني دفعاتٍ حمراءُ من إحدى عشرة في ليلةٍ واحدة (V16.66 → V16.74) سببُها
# واحد: الدفعُ كان يسبق الحارسَ، أو يكتفي بجزءٍ منه. هنا الترتيبُ يُقلَب:
# الحارسُ الكاملُ (وهو قائمةُ السحابة نفسُها) يختم شجرةَ الملفات التي فحصها،
# والدفعُ لا يمرُّ إلا لشجرةٍ مختومة. من دفع بلا ختمٍ شُغِّل الحارسُ له هنا،
# فيدفع أخضرَ أو لا يدفع.
#
# يُثبَّت تلقائيًّا (core.hooksPath=.githooks) عند أوّل تشغيلٍ للحارس أو
# للدورة السريعة. مخرجُ الطوارئ الوحيد معلَنٌ لا مخفيّ: NUSUK_NO_GATE=1.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

if [ "${NUSUK_NO_GATE:-}" = "1" ]; then
  echo "⚠ البوابةُ متجاوَزة بـ NUSUK_NO_GATE=1 — السحابةُ ستحكم وحدَها"
  exit 0
fi

GIT_DIR=$(git rev-parse --git-dir)
tree=$(git rev-parse 'HEAD^{tree}')
if [ -f "$GIT_DIR/nusuk-gate" ] && [ "$(cat "$GIT_DIR/nusuk-gate")" = "$tree" ]; then
  echo "✓ البوابة: الشجرةُ مختومةٌ بحارسٍ كاملٍ أخضر — تمرُّ"
  exit 0
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "✗ البوابة: الشجرةُ ليست نظيفة — ما يلي غيرُ ملتزَمٍ أو غيرُ متعقَّب؛ التزمه أو احذفه ثم ادفع:"
  git status --porcelain | head -12
  exit 1
fi

echo "البوابة: هذه الشجرةُ لم تُختَم — يُشغَّل الحارسُ الكاملُ (قائمةُ السحابة) قبل الدفع…"
if node scripts/check-version.mjs; then
  if [ -f "$GIT_DIR/nusuk-gate" ] && [ "$(cat "$GIT_DIR/nusuk-gate")" = "$tree" ]; then
    echo "✓ البوابة: أخضرُ — تمرُّ"
    exit 0
  fi
  echo "✗ البوابة: الحارسُ مرّ لكنّ الختمَ لا يطابق شجرةَ HEAD — التزم ما ولّده الحارسُ ثم ادفع"
  exit 1
fi
echo "✗ الدفعُ مرفوض — ما سقط أعلاه هو ما كانت السحابةُ ستسقط به. أصلِحه ثم ادفع."
exit 1
