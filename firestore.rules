// قواعد Nusuk المسح الميداني — تُنشر تلقائيًا عبر GitHub Actions
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isBoss(){ return request.auth != null
        && request.auth.token.email == 'mohammed.safwat@afaqy.com'; }
    function uDoc()  { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function ok()    { return isBoss() || (request.auth != null && uDoc().active == true); }
    function role()  { return isBoss() ? 'admin' : uDoc().role; }
    function mgr()   { return ok() && role() in ['engineer', 'admin']; }

    // الأدوارُ الميدانية: الفنيُّ والتهيئةُ والتجميعُ والتركيب. وهي التي تنتج
    // العملَ كلَّه — ولم تكن في هذه القائمة، فكانت القاعدةُ ترفض كلَّ مسحٍ
    // وكلَّ تركيبٍ يكتبه فنيّ. والتطبيقُ يقول «حُفظ» لأن الحفظَ محليٌّ أولًا،
    // ثم يقف الطابورُ عند الرفع ولا يصل المكتبَ شيء.
    function field()  { return role() in ['tech', 'cprep', 'casm', 'cins']; }
    function canW()   { return ok() && (role() in ['engineer', 'admin', 'supervisor'] || field()); }
    function viewer() { return ok() && role() == 'viewer'; }

    // المستخدمون: كل واحد يقرأ حسابه — المدير يقرأ الكل
    // الأدمن يكتب أي حساب — المهندس يكتب وثائق المشرفين فقط (بدون تغيير الدور)
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || mgr());
      // المهندس صلاحيته صلاحية الأدمن كاملةً على الحسابات
      allow create, update: if mgr();
      allow delete: if false;
    }

    // سجلات المسح والتركيب والمواقع المقترحة
    match /recs/{id} { allow read: if ok(); allow create, update: if canW(); allow delete: if mgr(); }
    match /inss/{id} { allow read: if ok(); allow create, update: if canW(); allow delete: if mgr(); }
    match /props/{id} { allow read: if ok(); allow create, update: if canW(); allow delete: if mgr(); }

    // صور المسح والتركيب — مستند لكل لقطة (فُصلت عن السجل لتجاوز حد 1MB)
    match /photos/{id} { allow read: if ok(); allow create, update: if canW(); allow delete: if mgr(); }

    // نبضات صحة الأجهزة — تكتبها أداة فحص المكتب ويقرؤها الجميع
    // أوامر المسح: المهندس ينشئ ويقفل، والمشرف يسجّل زياراته
    // مهام المسح: المهندس ينشئ ويعتمد، والفني يبدأ وينفّذ مهمته
    match /tasks/{id} {
      allow read: if ok();
      allow create, update: if canW();
      allow delete: if mgr();
    }
    match /srvorders/{id} {
      allow read: if ok();
      allow create, update: if canW();
      allow delete: if mgr();
    }
    match /hb/{id} { allow read: if ok(); allow write: if canW(); }

    // انتقالات الصحة (سقوط/عودة) — سجل إلحاقي للتحليلات لا يُعدَّل
    match /hbev/{id} { allow read: if ok(); allow create: if canW(); allow update, delete: if false; }

    // إعدادات مشتركة (الموعد المستهدف للمسح) — الجميع يقرأ، الإدارة تكتب
    // أرقام الهواتف (المكتب والشركات) للميدان والإدارة — لا تُعرض لحساب الوزارة
    // الهواتف: الميدانُ والإدارةُ يقرآن — والوزارةُ لا. والحجبُ هنا لا في
    // الواجهة وحدها، فالواجهةُ تُفتَح والقاعدةُ لا تُفتَح.
    match /settings/contacts { allow read: if canW(); allow write: if mgr(); }
    match /settings/cotel    { allow read: if canW(); allow write: if mgr(); }
    match /settings/{id} {
      allow read: if ok() && id != 'contacts' && id != 'cotel';
      allow write: if mgr();
    }

    // القائمة الموحّدة للشركات: المدير يضيف ويعتمد — المشرف طلبات فقط
    match /colist/{id} {
      allow read: if ok();
      allow write: if mgr();
      allow create: if ok() && role() == 'supervisor'
                    && request.resource.data.st == 'req';
    }

    // سجل الأحداث: قراءة للجميع — إضافة فقط — لا تعديل ولا حذف
    match /events/{id} {
      allow read: if ok();
      allow create: if canW();
      allow update, delete: if false;
    }

    // ── مجموعاتٌ كانت تسقط كلُّها في «misc» بلا قاعدةٍ خاصةٍ بها ──
    // سجلُّ الأحداث: أثرٌ تدقيقيٌّ يُكتَب ولا يُعدَّل ولا يُحذَف. الوزارةُ
    // تسأل من فعل ومتى، وأثرٌ يُعدَّل لا يصلح جوابًا.
    match /events/{id} {
      allow read:   if ok();
      allow create: if ok();
      allow update, delete: if false;
    }

    // اللقطاتُ اليومية: تُكتب من الميدان وتُقرأ من الجميع — وبها تُبنى
    // اللوحةُ بقراءةٍ واحدةٍ بدل ثلاثة آلاف.
    match /stats/{day} { allow read: if ok(); allow create, update: if canW(); allow delete: if false; }

    // الفكُّ والمواقعُ المقترحةُ وطلباتُ الشركات وحساباتُ الفنيين
    match /dismantles/{id} { allow read: if ok(); allow create, update: if canW(); allow delete: if mgr(); }
    match /newsites/{id}   { allow read: if ok(); allow create, update: if canW(); allow delete: if mgr(); }
    match /coreqs/{id}     { allow read: if ok(); allow create: if canW(); allow update, delete: if mgr(); }
    // طلباتُ التصويب: يكتبها الميدانُ ولا يعتمدها إلا المهندس
    match /fixreqs/{id}    { allow read: if ok(); allow create: if canW(); allow update: if mgr(); allow delete: if false; }
    // عناوينُ الشبكة على السجل الأمّ: يقرؤها الجميعُ ويكتبها من له التحرير
    match /sites/{id}      { allow read: if ok(); allow write: if canW(); allow delete: if false; }
    match /accounts/{id}   { allow read: if mgr(); allow create, update: if mgr(); allow delete: if false; }

    // المخزونُ والمشتريات — كانتا تُكتبان بلا قاعدةٍ فتُرفضان
    match /inventory/{id} { allow read: if ok(); allow create, update: if canW(); allow delete: if mgr(); }
    // المشترياتُ مالٌ داخليّ: لا يقرؤها الميدانُ ولا الوزارة
    match /purchases/{id} { allow read: if mgr(); allow create, update: if mgr(); allow delete: if mgr(); }

    // الفرقُ وخطُّ الأساس وطلباتُ التغيير والسلامةُ وعدمُ المطابقة والمستخلصات
    match /teams/{id}    { allow read: if ok();   allow create, update: if canW(); allow delete: if mgr(); }
    match /baseline/{id} { allow read: if ok();   allow create, update: if mgr();  allow delete: if false; }
    match /changes/{id}  { allow read: if ok();   allow create: if canW(); allow update: if mgr(); allow delete: if false; }
    match /hse/{id}      { allow read: if ok();   allow create, update: if canW(); allow delete: if mgr(); }
    match /ncr/{id}      { allow read: if ok();   allow create: if canW(); allow update: if mgr(); allow delete: if mgr(); }
    // المستخلصُ مالٌ: يُقرأ لمن يملك المال، ولا يعتمده إلا المهندس
    // المستخلصُ: يقرؤه المهندسُ والوزارةُ (فهو مستخلصُها المعتمَد) لا الميدان
    match /ipc/{id}      { allow read: if mgr() || viewer(); allow create: if mgr(); allow update: if mgr(); allow delete: if false; }

    // لا شيءَ يسقط في «misc» بعد اليوم
    match /misc/{id} { allow read, write: if false; }

  }
}
