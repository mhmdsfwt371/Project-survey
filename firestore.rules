// قواعد Nusuk المسح الميداني — تُنشر تلقائيًا عبر GitHub Actions
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isBoss(){ return request.auth != null
        && request.auth.token.email == 'mohammed.safwat@afaqy.com'; }
    function uDoc()  { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function ok()    { return isBoss() || (request.auth != null && uDoc().active == true); }
    function role()  { return isBoss() ? 'admin' : uDoc().role; }
    function mgr()   { return ok() && (role() == 'engineer' || role() == 'admin'); }
    function canW()  { return ok() && (role() == 'engineer' || role() == 'admin' || role() == 'supervisor'); }

    // المستخدمون: كل واحد يقرأ حسابه — المدير يقرأ الكل
    // الأدمن يكتب أي حساب — المهندس يكتب وثائق المشرفين فقط (بدون تغيير الدور)
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || mgr());
      // المهندس صلاحيته صلاحية الأدمن كاملةً على الحسابات
      allow create, update: if mgr();
      allow delete: if false;
    }

    // سجلات المسح والتركيب والمواقع المقترحة
    match /recs/{id} { allow read: if ok(); allow create, update: if canW(); allow delete: if mgr(); }
    match /inss/{id} { allow read: if ok(); allow create, update: if canW(); allow delete: if mgr(); }
    match /props/{id} { allow read: if ok(); allow create, update: if canW(); allow delete: if mgr(); }

    // صور المسح والتركيب — مستند لكل لقطة (فُصلت عن السجل لتجاوز حد 1MB)
    match /photos/{id} { allow read: if ok(); allow create, update: if canW(); allow delete: if mgr(); }

    // نبضات صحة الأجهزة — تكتبها أداة فحص المكتب ويقرؤها الجميع
    // أوامر المسح: المهندس ينشئ ويقفل، والمشرف يسجّل زياراته
    // مهام المسح: المهندس ينشئ ويعتمد، والفني يبدأ وينفّذ مهمته
    match /tasks/{id} {
      allow read: if ok();
      allow create, update: if canW();
      allow delete: if mgr();
    }
    match /srvorders/{id} {
      allow read: if ok();
      allow create, update: if canW();
      allow delete: if mgr();
    }
    match /hb/{id} { allow read: if ok(); allow write: if canW(); }

    // انتقالات الصحة (سقوط/عودة) — سجل إلحاقي للتحليلات لا يُعدَّل
    match /hbev/{id} { allow read: if ok(); allow create: if canW(); allow update, delete: if false; }

    // إعدادات مشتركة (الموعد المستهدف للمسح) — الجميع يقرأ، الإدارة تكتب
    // أرقام الهواتف (المكتب والشركات) للميدان والإدارة — لا تُعرض لحساب الوزارة
    match /settings/contacts { allow read: if canW(); allow write: if mgr(); }
    match /settings/cotel    { allow read: if canW(); allow write: if mgr(); }
    match /settings/{id} {
      allow read: if ok() && id != 'contacts' && id != 'cotel';
      allow write: if mgr();
    }

    // القائمة الموحّدة للشركات: المدير يضيف ويعتمد — المشرف طلبات فقط
    match /colist/{id} {
      allow read: if ok();
      allow write: if mgr();
      allow create: if ok() && role() == 'supervisor'
                    && request.resource.data.st == 'req';
    }

    // سجل الأحداث: قراءة للجميع — إضافة فقط — لا تعديل ولا حذف
    match /events/{id} {
      allow read: if ok();
      allow create: if canW();
      allow update, delete: if false;
    }
  }
}
