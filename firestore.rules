// قواعد Nusuk المسح الميداني — تُنشر تلقائيًا عبر GitHub Actions
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // token.email يُقرأ بـget بقيمةٍ افتراضية: الوصولُ المباشرُ إلى حقلٍ غائبٍ
    // في القواعد خطأٌ يُسقِط التقييمَ كلَّه فيُرفَض كلُّ شيء — وقد أسقط اختبارَ
    // المحاكي لأن حساباتِه بلا بريد؛ وسيُسقِط أيَّ حسابٍ مستقبليٍّ بلا بريد.
    // صاحبُ المشروع بأيِّ بريدٍ يدخل به: بريدُ الشركة أو اسمُ المستخدم في النظام
    function isBoss(){ return request.auth != null
        && request.auth.token.get('email', '') in ['mohammed.safwat@afaqy.com', 'm.safwat@nusuk.local']; }
    // وثيقةُ الحساب قد لا توجد أصلًا — وقراءةُ ما لا يوجد ليست فارغةً بل
    // **خطأٌ يُسقِط التقييمَ كلَّه** فيُرفَض كلُّ شيء بلا سببٍ يُقرأ. فيُسأل
    // عن وجودها أوّلًا: من لا وثيقةَ له ليس مرفوضًا بغموضٍ بل معروفًا أنه
    // بلا حساب — ويُتاح له أن يسجّل نفسَه فنيًّا (أدنى الأدوار) ليخرج من
    // البئر: حسابٌ بلا وثيقةٍ كان يُقفَل عليه الرفعُ كلُّه إلى الأبد.
    function uPath() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function uHas()  { return request.auth != null && exists(uPath()); }
    function uDoc()  { return get(uPath()).data; }
    // الحسابُ الفعّالُ من لم يُكتَب له active=false: كانت القاعدةُ تشترط
    // active==true، والحساباتُ التي يُنشئها التطبيقُ لم تكن تكتب الحقلَ —
    // فرُفض كلُّ حسابٍ جديدٍ بلا سببٍ يُرى («Missing or insufficient permissions»
    // على كلِّ رفع). التعطيلُ فعلٌ صريحٌ لا غيابُ حقل.
    function ok()    { return isBoss() || (uHas() && uDoc().get('active', true) != false); }
    // ═══ الأدوارُ المخصَّصة ═══
    // دورٌ يُضاف من التطبيق (settings/roles: { r: { <مفتاح>: { base, rank } } }) يُعامَل هنا
    // بدور أساسه في كلِّ شرط، وبرتبته المكتوبة، وبمفتاحه في مصفوفة الصلاحيات —
    // فيُضبَط وحدَه دون أن يُنشَر شيء. والمفتاحُ غيرُ المعروف بلا وثيقةٍ = بلا دور.
    function knownRole(r){ return r in ['exec', 'admin', 'engineer', 'supervisor', 'viewer', 'tech', 'cprep', 'casm', 'cins', 'buyer', 'store', 'acct', 'helper', 'driver']; }
    function rolesPath(){ return /databases/$(db)/documents/settings/roles; }
    function customRole(r){
      return exists(rolesPath()) ? get(rolesPath()).data.get('r', {}).get(r, {}) : {};
    }
    function docRole(){ return isBoss() ? 'admin' : (uHas() ? uDoc().get('role', 'tech') : 'none'); }
    function role()  { return knownRole(docRole()) ? docRole() : customRole(docRole()).get('base', 'none'); }
    function mgr()   { return ok() && role() in ['engineer', 'admin']; }

    // الأدوارُ الميدانية: الفنيُّ والتهيئةُ والتجميعُ والتركيب. وهي التي تنتج
    // العملَ كلَّه — ولم تكن في هذه القائمة، فكانت القاعدةُ ترفض كلَّ مسحٍ
    // وكلَّ تركيبٍ يكتبه فنيّ. والتطبيقُ يقول «حُفظ» لأن الحفظَ محليٌّ أولًا،
    // ثم يقف الطابورُ عند الرفع ولا يصل المكتبَ شيء.
    function field()  { return role() in ['tech', 'cprep', 'casm', 'cins', 'helper', 'driver']; }
    function canW()   { return ok() && (role() in ['engineer', 'admin', 'supervisor', 'buyer', 'store', 'acct'] || field()); }
    // الإدارةُ العليا تقرأ ولا تكتب: ليست في canW ولا mgr — وهي كالمطّلع
    // في القاعدة، إذنُها في التطبيق أوسعُ عرضًا لا كتابةً. فمن رفع بدورها
    // شيئًا رُفض، ومن قرأ رأى ما يقرؤه المطّلع.
    function viewer() { return ok() && role() in ['viewer', 'exec']; }
    // ═══ الرتبةُ في القاعدة كما في التطبيق ═══
    // كلُّ حسابٍ يرى من هو دونه رتبةً: المشرفُ يرى فنيّيه، والمهندسُ يرى
    // المشرفين ومن دونهم. وكانت القراءةُ للمهندس وحده — فالمشرفُ لا يرى
    // فريقَه أصلًا، ولا تُعرَف أسماءُ من يعمل تحته إلا من المكتب.
    function rnk(r) {
      return r == 'exec' ? 110
           : r == 'admin' ? 100
           : r == 'engineer' ? 90
           : r == 'supervisor' ? 70
           : r in ['cprep', 'casm', 'cins'] ? 50
           : r == 'viewer' ? 10 : 30;
    }
    function myRank() { return knownRole(docRole()) ? rnk(role()) : customRole(docRole()).get('rank', rnk(role())); }

    // ═══ مصفوفةُ الصلاحيات — تُكتَب من التطبيق وتُقرأ هنا ═══
    // settings/perms = { m: { <مجموعة>: { <دور>: { r|w|a|d: true|false|null } } } }
    // القيمةُ الصريحةُ تحكم، وnull أو الغيابُ = الافتراضيُّ المكتوبُ في كلِّ قاعدة
    // (كما كانت قبل المصفوفة). وصاحبُ المشروع ببريده لا تحكمه المصفوفةُ — فلا
    // يُقفَل على نفسه بضغطةٍ خاطئة. والثوابتُ (الأثرُ لا يُحذَف، الهواتفُ محجوبةٌ
    // عن الوزارة، لا كتابةَ بلا هوية) مكتوبةٌ خارجها ولا تصلها.
    function pmPath(){ return /databases/$(db)/documents/settings/perms; }
    function pmCell(col){
      // بمفتاح الدور كما في وثيقته — فالدورُ المخصَّصُ له خانتُه هو لا خانةُ أساسه
      return exists(pmPath()) ? get(pmPath()).data.get('m', {}).get(col, {}).get(docRole(), {}) : {};
    }
    function pm(col, op, dflt){
      return isBoss() || (ok() && (pmCell(col).get(op, null) == null ? dflt : pmCell(col)[op] == true));
    }

    // المستخدمون: كل واحد يقرأ حسابه — المدير يقرأ الكل
    // الأدمن يكتب أي حساب — المهندس يكتب وثائق المشرفين فقط (بدون تغيير الدور)
    // سجلُّ الصيانة: يكتبه الميدانُ ويقرؤه الجميع — كسجل التركيب
    match /maints/{id} {
      allow read:  if pm('maints', 'r', ok());
      allow create, update: if pm('maints', 'w', canW());
      allow delete: if pm('maints', 'd', canW());
    }
    // «آخرُ ما تمّ»: يُعلَن ولا يُعدَّل — سطرٌ يُكتَب مرةً ولا يُمحى، فهو
    // إعلانٌ لا سجلٌّ يُراجَع؛ وحذفُه يُخفي ما جرى.
    match /steps/{id} {
      allow read:   if pm('steps', 'r', ok());
      allow create: if pm('steps', 'w', canW());
      allow update, delete: if false;
    }
    // الحساباتُ المعلَّقة: سُجِّلت ولم تُنشَأ في المصادقة — يراها المكتبُ
    // كي لا تضيع في جهازٍ واحد، ويحذفُها حين تُفعَّل.
    // طلباتُ الإنشاء: يكتبها المكتبُ ويقرؤها — فيها كلمةُ مرورٍ مؤقتةٌ حتى
    // تُصدَّر الورقةُ وتُمسَح. الخادمُ يقرؤها بمفتاح المشروع لا بهذه القواعد.
    // ═══ كلٌّ يُنشئ في مستواه أو دونه ═══
    // المشرفُ فما فوق يكتب طلبًا بدورٍ لا يعلو دورَه — والقاعدةُ تقارن الرتبتين
    // على الطلب الواحد لا على قائمة. والقراءةُ: المديرُ كلَّها، وغيرُه ما كتبه
    // هو — بالاستعلام `where('by','==',اسمه)` فتُثبَت القاعدةُ على الشرط لا
    // على كلِّ وثيقة (وفي الطلب كلمةُ مرورٍ لا يراها إلا كاتبُها أو المدير).
    function canProv() { return ok() && myRank() >= 70; }
    // مفتاحُ تشغيل السيور: يكتبه مديرُ المشروع وحدَه — ويقرؤه من يُنشئ الحساباتِ
    // ويُعيد الكلماتِ (المشرفُ فما فوق) والإدارةُ العليا، فلا يُرسَل أحدٌ إلى GitHub.
    // المفتاحُ لا يملك إلا تشغيلَ السيور (Actions) — لا الشيفرةَ ولا القاعدة.
    match /ghcfg/{id} {
      allow read: if ok() && (role() == 'admin' || role() == 'exec' || myRank() >= 70);
      allow write: if ok() && role() == 'admin';
    }
    match /provision/{id} {
      allow read: if mgr() || (canProv() && resource.data.by == uDoc().name);
      // مديرُ المشروع وحدَه يُنشئ فوق مستواه (حسابَ الإدارة العليا) —
      // والمهندسُ كغيره: في مستواه فما دون
      allow create, update: if (ok() && role() == 'admin')
        || (canProv()
            && request.resource.data.by == uDoc().name
            && myRank() >= rnk(request.resource.data.get('role', 'tech')));
      allow delete: if mgr();
    }
    // الحضور: يكتبه صاحبُه وحدَه — وثيقتُه باسمه — ويقرؤه من فوقه
    match /att/{id} {
      allow read: if ok();
      allow create, update: if ok() && request.resource.data.uid == request.auth.uid
                             && id == request.auth.uid + '_' + request.resource.data.day;
      allow delete: if mgr();
    }
    match /pending/{id} {
      // الدعوةُ يقرؤها المكتبُ ليتابعها — ويقرؤها **غيرُ المسجَّل** ليفعّلها
      // بنفسه: بمئةٍ وخمسين شخصًا لا يقف كلُّ حسابٍ على المكتب. وليس فيها
      // سرٌّ: اسمٌ ودورٌ بلا كلمةِ مرور — والكلمةُ يضعها صاحبُها ولا تُخزَّن.
      // القراءةُ مفتوحةٌ عمدًا: من يفعّل دعوتَه لم يُسجَّل بعدُ فلا هويةَ له،
      // وليس في الدعوة سرّ — اسمٌ ودورٌ بلا كلمةِ مرور، والكلمةُ يضعها
      // صاحبُها ولا تُخزَّن. ولا يُقرَأ بها شيءٌ من بيانات المشروع.
      allow read: if resource == null || resource.data.keys().hasOnly(
        ['name','user','role','job','sup','dept','active','at','by','pending','jobLog']);
      allow create, update: if mgr();
      // ويمحوها من فعّلها: صار له حسابٌ باسم المستخدم نفسِه
      allow delete: if mgr()
        || (request.auth != null
            && exists(/databases/$(db)/documents/users/$(request.auth.uid))
            && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('user', '') == id);
    }
    match /users/{uid} {
      // ═══ لماذا لا تُقارَن الرتبةُ هنا ═══
      // جُرِّب شرطٌ يقارن رتبةَ القارئ برتبةِ الوثيقة، فسقطت قائمةُ
      // المستخدمين كلُّها: القاعدةُ تُقيِّد استعلامَ القائمة بعشرين نداءَ
      // وثيقةٍ في الاستعلام الواحد، وكلُّ تقييمٍ يستدعي `exists` و`get`
      // على وثيقة القارئ — فمع ثلاثمئة حساب يُتجاوَز السقفُ ويُرفَض
      // الاستعلامُ كلُّه، فتظهر الشاشةُ فارغةً على جهازٍ وممتلئةً على آخر.
      //   والاسمُ والدورُ ليسا سرًّا داخل الشركة — والسرُّ هو الجوّال،
      // وله حراستُه في العرض. فالقراءةُ لكلِّ حسابٍ فعّال، والترتيبُ
      // بالرتبة يُصفّى في التطبيق حيث لا يكلّف نداءً.
      allow read: if request.auth != null && (request.auth.uid == uid || ok());
      // المهندس صلاحيته صلاحية الأدمن كاملةً على الحسابات
      allow create, update: if pm('users', 'w', mgr())
        // صاحبُ الحساب يرفع «لم تعد مؤقتة» بعد أن يبدّل كلمتَه — الحقلان وحدهما،
        // ولا يرفع الوصفَ عن نفسه إلى مؤقتةٍ (mustChange=true يكتبه الخادم وحده)
        || (request.auth.uid == uid && exists(uPath())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange', 'pwAt', '_at', '_by'])
            && request.resource.data.get('mustChange', false) == false)
        // ومن دخل ولا وثيقةَ له يسجّل نفسَه — فنيًّا فقط ونشطًا: أدنى دورٍ
        // في النظام، ولا يرفع نفسَه ولا يكتب فوق وثيقةٍ قائمة. بها يخرج من
        // الحصار ويُرفَع عملُه، ويرقّيه المكتبُ إلى دوره الحقيقي.
        || (request.auth.uid == uid
            && !exists(uPath())
            && request.resource.data.get('active', true) == true
            && (
              // إمّا تسجيلٌ ذاتيٌّ فنيًّا (أدنى الأدوار)
              request.resource.data.role == 'tech'
              // وإمّا تفعيلُ دعوةٍ: الدورُ من الدعوة نفسِها لا من كاتبها
              || (exists(/databases/$(db)/documents/pending/$(request.resource.data.get('user', '\u0000')))
                  && get(/databases/$(db)/documents/pending/$(request.resource.data.user)).data.get('role', 'tech')
                     == request.resource.data.role)
            ));
      // الحذفُ للمهندس ومدير المشروع: لا نفسَه، ولا من هو أعلى منه رتبة
      allow delete: if pm('users', 'd', mgr()) && request.auth.uid != uid
                    && myRank() >= rnk(resource.data.get('role', 'tech'));
    }

    // سجلات المسح والتركيب والمواقع المقترحة
    /* اعتمادُ الزيارة (review == 'approved') فعلُ مديرٍ لا فعلَ من زار: المشرفُ
       يكتب سجلَّه وينتظر، ولو كتب 'approved' بيده ردّته القاعدةُ كما تردّ
       اعتمادَ التركيب. الرَّدُّ ('revisit') لا يرفع صلاحيةً فلا يُمنَع. */
    match /recs/{id} {
      allow read: if pm('recs', 'r', ok());
      // الكتابةُ (w) لمن يكتب العمل، والاعتمادُ (a) للإدارة — كلٌّ من المصفوفة بافتراضيّه
      allow create, update: if pm('recs', 'w', canW()) && (
        pm('recs', 'a', mgr()) ||
        (!('review' in request.resource.data) || request.resource.data.review != 'approved'));
      // ═══ اعتمادُ الوزارة لإعداد التركيب (V16.66) ═══
      // الفعلُ الوحيدُ الذي تكتبه الوزارة: حقولُ minReview وحدَها في وثيقةٍ قائمةٍ
      // اعتُمدت تقنيًّا — لا تُنشئ ولا تمسُّ حقلًا غيرَها، ولا تعتمد ما لم يعتمده المهندس.
      allow update: if ok() && role() == 'viewer'
        && resource.data.review == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['minReview', 'minBy', 'minAt', 'minNote', '_at', '_by'])
        && request.resource.data.minReview in ['approved', 'returned'];
      allow delete: if pm('recs', 'd', mgr());
    }
    /* اعتمادُ التركيب واعتمادُ حل التركيب فعلا مديرٍ لا فعلَ منفِّذ — كلاهما
       حقلٌ داخل هذه الوثيقة نفسها لا وثيقةٌ مستقلّة، فمن يملك canW() ليكتب
       تقريرَه يملك تقنيًّا الكتابةَ على approved أيضًا ما لم تُستثنَ صراحةً.
       التقنيُّ يقترح، والمهندسُ وحده يعتمد — لا فرقَ بين الاثنين في القاعدة
       العامة، ففُرِّق هنا. */
    match /inss/{id} {
      allow read: if pm('inss', 'r', ok());
      allow create: if pm('inss', 'w', canW());
      allow update: if pm('inss', 'w', canW()) && (
        pm('inss', 'a', mgr()) ||
        (request.resource.data.approved != true &&
        (!('solution' in request.resource.data) ||
         !('status' in request.resource.data.solution) ||
         request.resource.data.solution.status != 'معتمد'))
      );
      allow delete: if pm('inss', 'd', mgr());
    }
    match /props/{id} { allow read: if pm('props', 'r', ok()); allow create, update: if pm('props', 'w', canW()); allow delete: if pm('props', 'd', mgr()); }

    // صور المسح والتركيب — مستند لكل لقطة (فُصلت عن السجل لتجاوز حد 1MB)
    // الصورةُ تصعد من الهاتف بمحتواها ثم يمحوه الخادمُ بعد النقل؛ الحقلُ
    // `data` لا يُقرأ إلا للمكتب لأنه ثقيلٌ — والرابطُ يكفي الجميع.
    match /photos/{id} { allow read: if pm('photos', 'r', ok()); allow create, update: if pm('photos', 'w', canW()); allow delete: if pm('photos', 'd', mgr()); }

    // نبضات صحة الأجهزة — تكتبها أداة فحص المكتب ويقرؤها الجميع
    // أوامر المسح: المهندس ينشئ ويقفل، والمشرف يسجّل زياراته
    // مهام المسح: المهندس ينشئ ويعتمد، والفني يبدأ وينفّذ مهمته
    match /tasks/{id} {
      allow read: if pm('tasks', 'r', ok());
      allow create, update: if pm('tasks', 'w', canW());
      allow delete: if pm('tasks', 'd', mgr());
    }
    match /srvorders/{id} {
      allow read: if pm('srvorders', 'r', ok());
      allow create, update: if pm('srvorders', 'w', canW());
      allow delete: if pm('srvorders', 'd', mgr());
    }
    match /hb/{id} { allow read: if pm('hb', 'r', ok()); allow create, update: if pm('hb', 'w', canW()); allow delete: if pm('hb', 'd', canW()); }

    // انتقالات الصحة (سقوط/عودة) — سجل إلحاقي للتحليلات لا يُعدَّل
    match /hbev/{id} { allow read: if pm('hbev', 'r', ok()); allow create: if pm('hbev', 'w', canW()); allow update, delete: if false; }

    // إعدادات مشتركة (الموعد المستهدف للمسح) — الجميع يقرأ، الإدارة تكتب
    // أرقام الهواتف (المكتب والشركات) للميدان والإدارة — لا تُعرض لحساب الوزارة
    // الهواتف: الميدانُ والإدارةُ يقرآن — والوزارةُ لا. والحجبُ هنا لا في
    // الواجهة وحدها، فالواجهةُ تُفتَح والقاعدةُ لا تُفتَح.
    // الهواتفُ: المصفوفةُ تفتحها وتغلقها لمن يكتب — والوزارةُ والإدارةُ العليا لا، مهما قالت
    match /settings/contacts { allow read: if !viewer() && pm('phones', 'r', canW()); allow write: if pm('phones', 'w', mgr()); }
    match /settings/cotel    { allow read: if !viewer() && pm('phones', 'r', canW()); allow write: if pm('phones', 'w', mgr()); }
    // المصفوفةُ نفسُها: يقرؤها كلُّ فعّالٍ (التطبيقُ يعرض بها) ويكتبها المهندسُ فما فوق
    match /settings/perms    { allow read: if ok(); allow write: if ok() && myRank() >= 90; }
    match /settings/roles    { allow read: if ok(); allow write: if ok() && myRank() >= 90; }
    match /settings/{id} {
      allow read: if ok() && id != 'contacts' && id != 'cotel';
      allow write: if pm('settings', 'w', mgr());
    }

    // القائمة الموحّدة للشركات: المدير يضيف ويعتمد — المشرف طلبات فقط
    match /colist/{id} {
      allow read: if pm('colist', 'r', ok());
      allow write: if pm('colist', 'w', mgr());
      allow create: if ok() && role() == 'supervisor'
                    && request.resource.data.st == 'req';
    }

    // ── مجموعاتٌ كانت تسقط كلُّها في «misc» بلا قاعدةٍ خاصةٍ بها ──
    // سجلُّ الأحداث: أثرٌ تدقيقيٌّ يُكتَب ولا يُعدَّل ولا يُحذَف. الوزارةُ
    // تسأل من فعل ومتى، وأثرٌ يُعدَّل لا يصلح جوابًا.
    // ═══ لماذا يُقبَل التحديثُ الفارغ ═══
    // الطابورُ يُعيد إرسالَ وثيقةٍ كُتبت من قبل — انقطعت الشبكةُ بعد الوصول
    // قبل الجواب، أو اهتزّ الحفظُ فأُدرجت مرتين — فيصير الإرسالُ الثاني
    // «تحديثًا» تمنعه القاعدة، وتُرفَض ثلاثًا وتُعزَل وتُملأ شاشةُ المزامنة
    // أعطالًا لأثرٍ وصل أصلًا. فيُقبَل التحديثُ الذي لا يغيّر شيئًا سوى ختم
    // الدفعة (_at و_by) — والمحتوى يبقى كما كُتب أوّلَ مرة.
    match /events/{id} {
      allow read:   if pm('events', 'r', ok());
      // الأثرُ يكتبه من يعمل — لا المطّلعُ ولا الإدارةُ العليا فهما يقرآن فقط
      allow create: if pm('events', 'w', canW());
      allow update: if ok()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['_at', '_by']);
      allow delete: if false;
    }

    // اللقطاتُ اليومية: تُكتب من الميدان وتُقرأ من الجميع — وبها تُبنى
    // اللوحةُ بقراءةٍ واحدةٍ بدل ثلاثة آلاف.
    // اللقطاتُ اليومية مشتقّةٌ لا أثر: تصفيرُ الموسم يحذفها — للإدارة وحدَها (كانت لا تُحذَف
    // فيُرفَض أمرُ التصفير وتعود لقطاتُ التجارب مع أوّل سحب)
    match /stats/{day} { allow read: if pm('stats', 'r', ok()); allow create, update: if pm('stats', 'w', canW()); allow delete: if pm('stats', 'd', mgr()); }

    // الفكُّ والمواقعُ المقترحةُ وطلباتُ الشركات وحساباتُ الفنيين
    match /dismantles/{id} { allow read: if pm('dismantles', 'r', ok()); allow create, update: if pm('dismantles', 'w', canW()); allow delete: if pm('dismantles', 'd', mgr()); }
    match /newsites/{id} { allow read: if pm('newsites', 'r', ok()); allow create, update: if pm('newsites', 'w', canW()); allow delete: if pm('newsites', 'd', mgr()); }
    match /coreqs/{id} { allow read: if pm('coreqs', 'r', ok()); allow create: if pm('coreqs', 'w', canW()); allow update: if pm('coreqs', 'a', mgr()); allow delete: if pm('coreqs', 'd', mgr()); }
    // طلباتُ التصويب: يكتبها الميدانُ ولا يعتمدها إلا المهندس
    match /fixreqs/{id} { allow read: if pm('fixreqs', 'r', ok()); allow create: if pm('fixreqs', 'w', canW()); allow update: if pm('fixreqs', 'a', mgr()); allow delete: if pm('fixreqs', 'd', mgr()); }
    // عناوينُ الشبكة على السجل الأمّ: يقرؤها الجميعُ ويكتبها من له التحرير
    match /sites/{id} { allow read: if pm('sites', 'r', ok()); allow create, update: if pm('sites', 'w', canW()); allow delete: if false; }
    // الشحنات: يقرؤها الجميعُ ويكتبها من له التحرير — وما وصل لا يُحذَف
    match /ships/{id} { allow read: if pm('ships', 'r', ok()); allow create, update: if pm('ships', 'w', canW()); allow delete: if pm('ships', 'd', mgr()); }
    // الأسطول: يقرؤه الجميعُ ليعرف كلٌّ سيارتَه، ويكتبه من له التحرير
    match /vehicles/{id} { allow read: if pm('vehicles', 'r', ok()); allow create, update: if pm('vehicles', 'w', canW()); allow delete: if pm('vehicles', 'd', canW()); }
    match /vehAsn/{id} { allow read: if pm('vehAsn', 'r', ok()); allow create, update: if pm('vehAsn', 'w', canW()); allow delete: if false; }
    match /accounts/{id} { allow read: if pm('accounts', 'r', mgr()); allow create, update: if pm('accounts', 'w', mgr()); allow delete: if false; }

    // المخزونُ والمشتريات — كانتا تُكتبان بلا قاعدةٍ فتُرفضان
    match /inventory/{id} { allow read: if pm('inventory', 'r', ok()); allow create, update: if pm('inventory', 'w', canW()); allow delete: if pm('inventory', 'd', mgr()); }
    // المشترياتُ مالٌ داخليّ: لا يقرؤها الميدانُ ولا الوزارة
    match /purchases/{id} { allow read: if pm('purchases', 'r', mgr()); allow create, update: if pm('purchases', 'w', mgr()); allow delete: if pm('purchases', 'd', mgr()); }

    // الفرقُ وخطُّ الأساس وطلباتُ التغيير والسلامةُ وعدمُ المطابقة والمستخلصات
    match /teams/{id} { allow read: if pm('teams', 'r', ok()); allow create, update: if pm('teams', 'w', canW()); allow delete: if pm('teams', 'd', mgr()); }
    /* نقاطُ الزيادة: قرارُ من يشرف لا من يُنفَّذ له — مشرفٌ أو مهندسٌ وحدهما،
       لا كلُّ من يملك canW() (فالفنيَّ وقائدَ الفريق الميدانيّ يرثانها أيضًا). */
    // نقاطُ الزيادة قرارٌ فوق الميدان: المهندسُ ومديرُ المشروع والإدارةُ العليا —
    // لا المشرفُ ولا الفنيّ؛ فالنقاطُ تدخل المستحقَّ ولا تُترَك لمن يعمل مع من
    // يقيّمه يومًا بيوم.
    match /bonus/{id}    { allow read: if pm('bonus', 'r', ok());
                            allow create, update: if pm('bonus', 'w', ok() && myRank() >= 90);
                            allow delete: if pm('bonus', 'd', ok() && myRank() >= 90); }
    match /workreqs/{id} { allow read: if pm('workreqs', 'r', ok()); allow create, update: if pm('workreqs', 'w', canW()); allow delete: if pm('workreqs', 'd', mgr()); }
    match /baseline/{id} { allow read: if pm('baseline', 'r', ok()); allow create, update: if pm('baseline', 'w', mgr()); allow delete: if false; }
    match /changes/{id} { allow read: if pm('changes', 'r', ok()); allow create: if pm('changes', 'w', canW()); allow update: if pm('changes', 'a', mgr()); allow delete: if false; }
    match /hse/{id} { allow read: if pm('hse', 'r', ok()); allow create, update: if pm('hse', 'w', canW()); allow delete: if pm('hse', 'd', mgr()); }
    match /ncr/{id} { allow read: if pm('ncr', 'r', ok()); allow create: if pm('ncr', 'w', canW()); allow update: if pm('ncr', 'a', mgr()); allow delete: if pm('ncr', 'd', mgr()); }
    // المستخلصُ مالٌ: يُقرأ لمن يملك المال، ولا يعتمده إلا المهندس
    // المستخلصُ: يقرؤه المهندسُ والوزارةُ (فهو مستخلصُها المعتمَد) لا الميدان
    match /ipc/{id} { allow read: if pm('ipc', 'r', mgr() || viewer()); allow create, update: if pm('ipc', 'w', mgr()); allow delete: if false; }

    // لا شيءَ يسقط في «misc» بعد اليوم
    // حضورُ الأجهزة: كلُّ جهازٍ يكتب وثيقتَه هو (النسخةُ والدورُ والوقت) — تليمتري لا
    // بيانات، فيكتبها المطّلعُ والإدارةُ العليا أيضًا؛ ويقرؤها كلُّ فعّال، والحذفُ للإدارة
    match /presence/{uid} { allow read: if ok(); allow create, update: if ok() && request.auth.uid == uid; allow delete: if mgr(); }
    match /misc/{id} { allow read, write: if false; }

  }
}
